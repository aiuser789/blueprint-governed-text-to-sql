        "analyst": "all",
        "privacy_officer": "all",
        "supervisor_officer": "customer_id IN (SELECT c.customer_id FROM demo_banking.customers c JOIN demo_banking.branches b USING (branch_id) WHERE b.region = ctx.region())",
        "sales_rep": "none",
        "contractor": "none"
