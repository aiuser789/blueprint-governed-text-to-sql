        "supervisor_officer": "account_id IN (SELECT a.account_id FROM demo_banking.accounts a JOIN demo_banking.customers c USING (customer_id) JOIN demo_banking.branches b USING (branch_id) WHERE b.region = ctx.region())",
        "sales_rep": "none",
        "contractor": "none"
