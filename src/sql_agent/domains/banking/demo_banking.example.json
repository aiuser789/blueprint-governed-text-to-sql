        "created_at": {
          "type": "timestamp with time zone",
          "description": ""
        }
      },
      "rows": {
        "analyst": "all",
        "privacy_officer": "all",
        "supervisor_officer": "branch_id IN (SELECT b.branch_id FROM demo_banking.branches b WHERE b.region = ctx.region())",
        "sales_rep": "none",
        "contractor": "none"
      }
    },
    {
