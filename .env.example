# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, demo, evals).
# A variable set in the real environment always takes precedence over .env.

# ===========================================================================
# PostgreSQL — required. RLS and PII masking are enforced here.
# ===========================================================================
# Two connections, two roles, on purpose:
#
#   DATABASE_URL        the service role (nl2sql). Runs migrations, mints
#                       per-question session tokens, writes the audit log.
#                       It NEVER executes model-written SQL.
#   AGENT_DATABASE_URL  the agent role (nl2sql_agent). Executes model-written
#                       SQL. SELECT on the analytics views only; no access to
#                       base tables, sessions, users or the audit log.
#
# Unset AGENT_DATABASE_URL = derived from DATABASE_URL with the agent
# role's name and AGENT_DB_PASSWORD swapped in.
DATABASE_URL=postgresql://nl2sql:nl2sql@localhost:5432/nl2sql
# AGENT_DATABASE_URL=postgresql://nl2sql_agent:agent-local-only@localhost:5432/nl2sql
AGENT_DB_PASSWORD=agent-local-only
#
# Supabase (Session pooler, port 5432 — not the transaction pooler on 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# AGENT_DB_PASSWORD=<random, 16+ characters>    (required for any non-local database)
# The agent then connects as nl2sql_agent.<project-ref> automatically.
# URL-encode special characters in passwords: @ → %40, / → %2F, : → %3A, # → %23
#
# Keep the database password out of this file: leave it out of DATABASE_URL
# (postgresql://postgres.<project-ref>@aws-0-...:5432/postgres?sslmode=require)
# and put it in .password.env next to this file — loaded automatically, git-ignored:
#   DATABASE_PASSWORD=<db-password>          (plain text; no URL-encoding needed)

# ===========================================================================
# Model backend — recommended: a local model with Ollama
# ===========================================================================
# Ollama runs the model on your own machine: free, no API key, and the
# schema, questions and (already masked) results never leave it.
#   1. Install Ollama (https://ollama.com) and start it (the app, or `ollama serve`)
#   2. ollama pull qwen2.5-coder:7b
#   3. sql-agent viewer        (checks the database and the model)
MODEL_BACKEND=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434     (in Docker: http://host.docker.internal:11434)
# OLLAMA_NUM_CTX=8192                         (context window; the prompt needs more than Ollama's default)
#
# Bigger local models write better SQL if your machine can run them
# (e.g. qwen2.5-coder:14b or :32b). Any model Ollama can pull works.
#
# MODEL_BACKEND=mock              the offline planner: no model at all. Knows only
#                                 the demo question patterns; used by the evals.
#
# Hosted alternatives (data is sent to the provider):
# MODEL_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# MODEL_BACKEND=openai            (OpenAI, NVIDIA NIM, vLLM, any OpenAI-compatible endpoint)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=                   (required — no default model name)
# OPENAI_BASE_URL=

# ===========================================================================
# Behaviour knobs (all optional)
# ===========================================================================
# AS_OF_DATE=2026-09-30           "today" for relative periods (the synthetic
#                                 data ends here; keep it for reproducible evals)
#                                 For your own data use AS_OF_DATE=today
# RETAIL_DATA=on                  off = leave the retail data out of API/CLI calls without a data
#                                 choice; the console's Data menu still offers Retail explicitly
# DATASETS_DIR=datasets           where `sql-agent dataset propose/apply` keep their specs
# FISCAL_YEAR_START_MONTH=2       fiscal year starts 1 Feb (retail calendar)
# STATEMENT_TIMEOUT_MS=15000      per-query timeout, set inside the transaction
# MAX_RESULT_ROWS=1000            rows returned to a user per question
# EXPORT_MAX_ROWS=50000           rows in an approved export
# MAX_SQL_ATTEMPTS=3              generate → validate retries before declining
# SESSION_TTL_SECONDS=60          lifetime of a per-question session token
# LLM_TIMEOUT_SECONDS=           per model call; default 60 (hosted), 300 (Ollama: the first call loads the model)
# LLM_MAX_TOKENS=2000

# ===========================================================================
# API
# ===========================================================================
# API_KEY=                        when set, data endpoints require X-API-Key
# DEMO_IDENTITY=on                X-Demo-User header picks a synthetic user.
#                                 Prototype only — replace with SSO/JWT.
